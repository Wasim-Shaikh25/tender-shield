# Production environment
# This file is a template. Replace all placeholders with real secrets in your
# deployed environment (SSM / Secrets Manager / 1Password), never commit them.
TS_ENV=prod

TS_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/tendershield

TS_CORS_ORIGINS=https://app.tendershield.io
TS_ALLOWED_HOSTS=app.tendershield.io

TS_STORAGE_TYPE=s3
TS_STORAGE_DIR=uploads
# TS_S3_BUCKET=
# TS_S3_REGION=
# TS_S3_ENDPOINT_URL=
# TS_S3_ACCESS_KEY_ID=
# TS_S3_SECRET_ACCESS_KEY=

# Redis is required in production for distributed rate limiting and scheduling.
# TS_REDIS_URL=redis://<user>:<pass>@<host>:6379/0

# Auth: real RS256 PEM keypair, rotated quarterly.
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing providers: all are required in production.
# TS_RAZORPAY_KEY_ID=
# TS_RAZORPAY_KEY_SECRET=
# TS_RAZORPAY_WEBHOOK_SECRET=
# TS_STRIPE_SECRET_KEY=
# TS_STRIPE_PUBLISHABLE_KEY=
# TS_STRIPE_WEBHOOK_SECRET=

# Notifications: at least one sender must be configured.
# TS_SES_REGION=
# TS_SES_ACCESS_KEY_ID=
# TS_SES_SECRET_ACCESS_KEY=
# TS_EMAIL_FROM=noreply@tendershield.io
# TS_MSG91_AUTH_KEY=
# TS_MSG91_SENDER_ID=

# OIDC (optional)
# TS_APPLE_TEAM_ID=
# TS_APPLE_SERVICES_ID=
# TS_APPLE_KEY_ID=
# TS_APPLE_PRIVATE_KEY=
# TS_APPLE_REDIRECT_URI=
# TS_GOOGLE_CLIENT_ID=
# TS_GOOGLE_CLIENT_SECRET=
# TS_GOOGLE_REDIRECT_URI=

# LLM / OCR
# TS_OPENROUTER_API_KEY=          # or OPENROUTER_API_KEY
# TS_OPENROUTER_MODEL=openai/gpt-4o-mini
TS_OCR_ENABLED=false

# Risk rulepacks: set to true only if unvalidated patterns are explicitly surfaced
# to paid users with a beta disclaimer; default keeps paid users on validated-only.
# TS_BETA_UNVALIDATED=false

NEXT_PUBLIC_API_URL=https://app.tendershield.io/api
