# Example template. Use one of the concrete env files for a real environment:
# .env.local (development), .env.dev (staging), .env.prod (production).
# All backend vars use the TS_ prefix.

# Environment: dev | prod (production enforces stricter startup guards)
TS_ENV=dev

# Database (Postgres in real deploys; RLS org-isolation is Postgres-only)
TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@db:5432/tendershield

# CORS origin for the SPA
TS_CORS_ORIGINS=http://localhost:3000

# Allowed Hosts (comma-separated; no '*' in production)
TS_ALLOWED_HOSTS=*

# Auth — RS256 PEM keypair (generate real keys for prod; dev auto-generates ephemeral)
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=
# TS_AUTH_MOBILE_VERIFICATION_ENABLED=false  # require phone and verify it on sign-up
# TS_AUTH_LOGIN_OTP_ENABLED=true             # false disables all OTP; password login returns tokens
# TS_AUTH_EMAIL_OTP_ENABLED=true               # allow passwordless login via email OTP
# TS_AUTH_SMS_OTP_ENABLED=false                # allow passwordless login via SMS OTP

# Billing — webhook secret (the only billing truth; REQUIRED in prod)
# TS_RAZORPAY_WEBHOOK_SECRET=

# Storage: local or s3
TS_STORAGE_TYPE=local
TS_STORAGE_DIR=./.tender_storage
# TS_S3_BUCKET=
# TS_S3_REGION=
# TS_S3_ENDPOINT_URL=
# TS_S3_ACCESS_KEY_ID=
# TS_S3_SECRET_ACCESS_KEY=

# MinIO example (self-hosted, S3-compatible):
# TS_STORAGE_TYPE=s3
# TS_S3_BUCKET=tendershield
# TS_S3_REGION=us-east-1
# TS_S3_ENDPOINT_URL=http://localhost:9000
# TS_S3_ACCESS_KEY_ID=minioadmin
# TS_S3_SECRET_ACCESS_KEY=minioadmin-password

# Notifications (at least one sender must be configured in production)
# TS_EMAIL_FROM=noreply@example.com
# TS_SES_REGION=
# TS_SES_ACCESS_KEY_ID=
# TS_SES_SECRET_ACCESS_KEY=
# TS_RESEND_API_KEY=
# TS_BREVO_API_KEY=
# TS_MSG91_AUTH_KEY=
# TS_MSG91_SENDER_ID=

# Redis (optional; in-memory fallback for rate limiting if unset)
# TS_REDIS_URL=

# LLM / OCR — set to switch on risk-clause judgment + assistant free-form answers
# TS_OPENROUTER_API_KEY=          # or OPENROUTER_API_KEY
# TS_OPENROUTER_MODEL=openrouter/free
# TS_OCR_ENABLED=false

# Risk rulepacks: show unvalidated patterns with a beta disclaimer.
TS_BETA_UNVALIDATED=true

# OpenTelemetry tracing — point to a Jaeger, Grafana Tempo, or hosted OTLP endpoint.
TS_OTEL_ENABLED=false
TS_OTEL_SERVICE_NAME=tendershield-backend
TS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# TS_OTEL_EXPORTER_OTLP_HEADERS=api-key=...

# Per-request access logging. Rotate and ship these files to Loki/Splunk/CloudWatch.
TS_ACCESS_LOG_ENABLED=true
TS_LOG_REQUEST_BODIES=false
TS_LOG_FILE=logs/tendershield-access.log
TS_APP_LOG_FILE=logs/tendershield-app.log
TS_LOG_JSON=true

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
