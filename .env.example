# Example template. Use one of the concrete env files for a real environment:
# .env.local (development), .env.dev (staging), .env.prod (production).
# All backend vars use the TS_ prefix.

# Environment: dev | prod (production enforces stricter startup guards)
TS_ENV=dev

# Database (Postgres in real deploys; RLS org-isolation is Postgres-only)
TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@db:5432/tendershield

# CORS origin for the SPA
TS_CORS_ORIGINS=http://localhost:3000

# Allowed Hosts (comma-separated; no '*' in production)
TS_ALLOWED_HOSTS=*

# Auth — RS256 PEM keypair (generate real keys for prod; dev auto-generates ephemeral)
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing — webhook secret (the only billing truth; REQUIRED in prod)
# TS_RAZORPAY_WEBHOOK_SECRET=

# Storage: local or s3
TS_STORAGE_TYPE=local
TS_STORAGE_DIR=./.tender_storage
# TS_S3_BUCKET=
# TS_S3_REGION=
# TS_S3_ENDPOINT_URL=
# TS_S3_ACCESS_KEY_ID=
# TS_S3_SECRET_ACCESS_KEY=

# Redis (optional; in-memory fallback for rate limiting if unset)
# TS_REDIS_URL=

# LLM / OCR — set to switch on risk-clause judgment + assistant free-form answers
# ANTHROPIC_API_KEY=
# TS_OCR_ENABLED=false

# Risk rulepacks: show unvalidated patterns with a beta disclaimer.
TS_BETA_UNVALIDATED=true

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
