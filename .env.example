# Example template. Use one of the concrete env files for a real environment:
# .env.local (development), .env.dev (staging), .env.prod (production).
# All backend vars use the TS_ prefix.

# Database (Postgres in real deploys; RLS org-isolation is Postgres-only)
TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@db:5432/tendershield

# CORS origin for the SPA
TS_CORS_ORIGINS=http://localhost:3000

# Auth — RS256 PEM keypair (generate real keys for prod; dev auto-generates ephemeral)
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing — Razorpay order creation + webhook verification (R-005). Leave the
# key id/secret empty in an environment with no live provider configured —
# checkout then returns 503 payment_provider_unavailable instead of a fake order.
TS_RAZORPAY_KEY_ID=
TS_RAZORPAY_KEY_SECRET=
TS_RAZORPAY_WEBHOOK_SECRET=change-me

# GST invoicing (R-007) — seller identity is configuration, not code. Verify
# with the company's CA before the first live invoice.
TS_SELLER_LEGAL_NAME=TenderShield Technologies Private Limited
TS_SELLER_GSTIN=
TS_SELLER_STATE_CODE=27
TS_SELLER_ADDRESS=
TS_INVOICE_SERIES_PREFIX=TS

# DEV/TEST ONLY. Returns password-reset/invitation tokens in the API response
# instead of only emailing them. NEVER true in production — startup refuses
# TS_ENV=production with this set (unauthenticated account takeover).
TS_DEV_ECHO_TOKENS=false

# Base URL of the frontend SPA, used to build links in transactional email.
TS_APP_URL=http://localhost:3000

# Uploaded-file storage root (S3 in prod)
TS_STORAGE_DIR=./.tender_storage

# LLM — set to switch on risk-clause judgment + assistant free-form answers
# ANTHROPIC_API_KEY=

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Public Razorpay key id — safe to expose client-side, mirrors TS_RAZORPAY_KEY_ID.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
