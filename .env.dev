# Staging / docker-compose environment
# No real secrets in this committed template; replace placeholders before use.
TS_ENV=dev

TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@db:5432/tendershield

TS_CORS_ORIGINS=http://localhost:3000
TS_ALLOWED_HOSTS=*

TS_STORAGE_TYPE=local
TS_STORAGE_DIR=/app/storage

# Redis is strongly recommended for staging when testing multi-instance behaviour.
# TS_REDIS_URL=redis://redis:6379/0

# Auth: generate real RS256 PEM keys for staging; do not rely on ephemeral keys.
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing / notifications / OIDC live integrations are gated by credentials.
# When unset, the app uses dev/test fallbacks (logged, never charged).
# TS_RAZORPAY_KEY_ID=
# TS_RAZORPAY_KEY_SECRET=
# TS_RAZORPAY_WEBHOOK_SECRET=
# TS_STRIPE_SECRET_KEY=
# TS_STRIPE_PUBLISHABLE_KEY=
# TS_STRIPE_WEBHOOK_SECRET=
# TS_SES_REGION=
# TS_SES_ACCESS_KEY_ID=
# TS_SES_SECRET_ACCESS_KEY=
# TS_EMAIL_FROM=noreply@example.com
# TS_MSG91_AUTH_KEY=
# TS_MSG91_SENDER_ID=
# TS_APPLE_TEAM_ID=
# TS_APPLE_SERVICES_ID=
# TS_APPLE_KEY_ID=
# TS_APPLE_PRIVATE_KEY=
# TS_APPLE_REDIRECT_URI=
# TS_GOOGLE_CLIENT_ID=
# TS_GOOGLE_CLIENT_SECRET=
# TS_GOOGLE_REDIRECT_URI=

# LLM / OCR
# ANTHROPIC_API_KEY=
TS_OCR_ENABLED=false

NEXT_PUBLIC_API_URL=http://localhost:8000/api
