# Staging / docker-compose environment
# No real secrets in this committed template; replace placeholders before use.
TS_ENV=dev

TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@db:5432/tendershield

TS_CORS_ORIGINS=http://localhost:3000
TS_ALLOWED_HOSTS=*

TS_STORAGE_TYPE=local
TS_STORAGE_DIR=/app/storage

# Storage: MinIO example. Set TS_STORAGE_TYPE=s3 and the endpoint below when MinIO is running.
# TS_STORAGE_TYPE=s3
# TS_S3_BUCKET=tendershield
# TS_S3_ENDPOINT_URL=http://minio:9000
# TS_S3_REGION=us-east-1
# TS_S3_ACCESS_KEY_ID=minio
# TS_S3_SECRET_ACCESS_KEY=minio123

# Redis is strongly recommended for staging when testing multi-instance behaviour.
# TS_REDIS_URL=redis://redis:6379/0

# Auth: generate real RS256 PEM keys for staging; do not rely on ephemeral keys.
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing / notifications / OIDC live integrations are gated by credentials.
# When unset, the app uses dev/test fallbacks (logged, never charged).
# TS_RAZORPAY_KEY_ID=
# TS_RAZORPAY_KEY_SECRET=
# TS_RAZORPAY_WEBHOOK_SECRET=
# TS_STRIPE_SECRET_KEY=
# TS_STRIPE_PUBLISHABLE_KEY=
# TS_STRIPE_WEBHOOK_SECRET=
# TS_SES_REGION=
# TS_SES_ACCESS_KEY_ID=
# TS_SES_SECRET_ACCESS_KEY=
# TS_EMAIL_FROM=noreply@example.com
# TS_MSG91_AUTH_KEY=
# TS_MSG91_SENDER_ID=
# TS_APPLE_TEAM_ID=
# TS_APPLE_SERVICES_ID=
# TS_APPLE_KEY_ID=
# TS_APPLE_PRIVATE_KEY=
# TS_APPLE_REDIRECT_URI=
# TS_GOOGLE_CLIENT_ID=
# TS_GOOGLE_CLIENT_SECRET=
# TS_GOOGLE_REDIRECT_URI=

# LLM / OCR
# TS_OPENROUTER_API_KEY=          # or OPENROUTER_API_KEY
# TS_OPENROUTER_MODEL=openrouter/free
TS_OCR_ENABLED=false

# Risk rulepacks: show unvalidated patterns with a beta disclaimer in dev/staging.
TS_BETA_UNVALIDATED=true

# OpenTelemetry tracing. Enable and point to Jaeger when running the observability profile.
TS_OTEL_ENABLED=false
TS_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
TS_OTEL_SERVICE_NAME=tendershield-backend

# Per-request access logging. In docker the logs are written to a shared volume
# scraped by Promtail and sent to Loki.
TS_ACCESS_LOG_ENABLED=true
TS_LOG_REQUEST_BODIES=false
TS_LOG_FILE=/var/log/tendershield/tendershield-access.log
TS_APP_LOG_FILE=/var/log/tendershield/tendershield-app.log
TS_LOG_JSON=true

NEXT_PUBLIC_API_URL=http://localhost:8000/api
