# Validation run environment — isolated SQLite DB, auth OTP/MFA disabled.
# Usage: TS_ENV=validation ./scripts/run.sh validation  OR
#        set -a && source .env.validation && set +a && cd backend && .venv/bin/uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8000
TS_ENV=validation

TS_DATABASE_URL=sqlite:///./validation.db
TS_CORS_ORIGINS=http://localhost:3000
TS_ALLOWED_HOSTS=*

TS_STORAGE_TYPE=local
TS_STORAGE_DIR=./.validation_storage

# Auth: disable mobile verification and login OTP so the validation script can
# sign up and log in with email+password only.
TS_AUTH_MOBILE_VERIFICATION_ENABLED=false
TS_AUTH_LOGIN_OTP_ENABLED=false
TS_AUTH_EMAIL_OTP_ENABLED=false
TS_AUTH_SMS_OTP_ENABLED=false

# LLM / OCR — off by default to keep validation cheap and deterministic.
# Set TS_OPENROUTER_API_KEY to enable risk LLM classification.
# TS_OPENROUTER_API_KEY=
# `openrouter/free` is very slow/unpredictable for 50-tender runs; use a cheap
# fast OpenRouter model such as openai/gpt-3.5-turbo, anthropic/claude-3-haiku,
# or meta-llama/llama-3.1-8b-instruct when a key is available.
TS_OPENROUTER_MODEL=openai/gpt-3.5-turbo
TS_OCR_ENABLED=false

# Risk rulepacks: show unvalidated patterns with a beta disclaimer.
TS_BETA_UNVALIDATED=true

# Telemetry off for validation runs.
TS_OTEL_ENABLED=false
TS_ACCESS_LOG_ENABLED=true
TS_LOG_REQUEST_BODIES=false
TS_LOG_FILE=logs/tendershield-access.log
TS_APP_LOG_FILE=logs/tendershield-app.log
TS_LOG_JSON=true

NEXT_PUBLIC_API_URL=http://localhost:8000/api
