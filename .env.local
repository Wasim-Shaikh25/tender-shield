# Local development environment for ./scripts/run.sh local
# No real secrets in this committed template; copy to .env for overrides.
TS_ENV=dev

# SQLite is used for quick local dev. For a Postgres mirror, uncomment the line
# below and start the docker-compose db service with .env.dev.
TS_DATABASE_URL=sqlite:///./tendershield.db
# TS_DATABASE_URL=postgresql+psycopg://tendershield:tendershield@localhost:5432/tendershield

TS_CORS_ORIGINS=http://localhost:3000
TS_ALLOWED_HOSTS=*

TS_STORAGE_TYPE=local
TS_STORAGE_DIR=./.tender_storage

# Redis is optional; an in-memory fallback is used when unset.
# TS_REDIS_URL=redis://localhost:6379/0

# Auth keys are auto-generated ephemeral in dev when these are unset.
# TS_JWT_PRIVATE_KEY=
# TS_JWT_PUBLIC_KEY=

# Billing / notifications / OIDC live integrations are gated by credentials.
# When unset, the app uses dev/test fallbacks (logged, never charged).
# TS_RAZORPAY_KEY_ID=
# TS_RAZORPAY_KEY_SECRET=
# TS_RAZORPAY_WEBHOOK_SECRET=
# TS_STRIPE_SECRET_KEY=
# TS_STRIPE_PUBLISHABLE_KEY=
# TS_STRIPE_WEBHOOK_SECRET=
# TS_SES_REGION=
# TS_SES_ACCESS_KEY_ID=
# TS_SES_SECRET_ACCESS_KEY=
# TS_EMAIL_FROM=noreply@example.com
# TS_MSG91_AUTH_KEY=
# TS_MSG91_SENDER_ID=
# TS_APPLE_TEAM_ID=
# TS_APPLE_SERVICES_ID=
# TS_APPLE_KEY_ID=
# TS_APPLE_PRIVATE_KEY=
# TS_APPLE_REDIRECT_URI=
# TS_GOOGLE_CLIENT_ID=
# TS_GOOGLE_CLIENT_SECRET=
# TS_GOOGLE_REDIRECT_URI=

# LLM / OCR — off by default in local dev.
# TS_OPENROUTER_API_KEY=          # or OPENROUTER_API_KEY
# TS_OPENROUTER_MODEL=openai/gpt-4o-mini
TS_OCR_ENABLED=false

# Risk rulepacks: show unvalidated patterns with a beta disclaimer in local dev.
TS_BETA_UNVALIDATED=true

# OpenTelemetry tracing. Set TS_OTEL_ENABLED=true and start Jaeger to see traces.
TS_OTEL_ENABLED=false
TS_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TS_OTEL_SERVICE_NAME=tendershield-backend

NEXT_PUBLIC_API_URL=http://localhost:8000/api
