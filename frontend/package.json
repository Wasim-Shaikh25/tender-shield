{
  "name": "tendershield-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "a11y": "node scripts/axe-ci.mjs",
    "generate:api": "openapi-typescript http://localhost:8000/openapi.json -o lib/api-types.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "next": "^15.5.21",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "axe-core": "^4.12.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.22",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^24.1.3",
    "@playwright/test": "^1.45.3",
    "openapi-typescript": "^7.6.1",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "brace-expansion": "5.0.8"
  }
